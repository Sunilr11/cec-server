<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Authors>$(AssemblyName), CodinCity</Authors>
		<Title>GDT.CEC</Title>
		<Copyright>CodinCity©</Copyright>
		<Company>CodinCity</Company>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UserSecretsId>e6ef985c-11c7-4813-ae78-122131acbca0</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>1591;1573</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <Content Remove="wwwroot\Templates\credTemplate.html" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="wwwroot\Templates\credTemplate.html" />
	  <None Include="wwwroot\Templates\otpTemplate.html" />
	</ItemGroup>
	

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Microsoft.Identity.Web" Version="2.20.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.6" />
		<PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
		<PackageReference Include="Serilog" Version="3.1.1" />
		<PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\GDT.CEC.Service\GDT.CEC.Service.csproj" />
	</ItemGroup>

</Project>
